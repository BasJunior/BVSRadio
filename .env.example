# BVSRadio Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bvsradio
DB_USER=postgres
DB_PASSWORD=replace_with_a_strong_password
DB_SSL=false
DB_POOL_MAX=20

# Server Configuration
PORT=3000
NODE_ENV=development
# Set only when running behind a trusted reverse proxy/load balancer.
TRUST_PROXY=0

# Authentication
# Use at least 32 random characters. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ISSUER=bvsradio
JWT_AUDIENCE=bvsradio-api

# CORS - comma-separated exact origins
CORS_ORIGIN=https://bvsradio.com,https://www.bvsradio.com

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Streaming Settings
STREAM_BUFFER_SIZE=1048576
MAX_BITRATE=320

# Redis Configuration (recommended for shared rate limiting/sessions in production)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@bvsradio.com
SMTP_PASSWORD=replace_with_smtp_password

# Payment Gateway
# Keep secret keys server-side only and rotate any key ever committed publicly.
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_PUBLIC_KEY=replace_with_stripe_publishable_key

# Cloud Storage
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
AWS_REGION=us-east-1
S3_BUCKET=bvsradio-media
